{
  "name": "dsh-status-overlay",
  "version": "0.1.0",
  "description": "Desktop overlay for DeepSeek Harness (Linux/UOS, arm64) plus a zero-dependency cross-platform MCP server exposing the live agent status.",
  "license": "MIT",
  "author": "huangshichao",
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "dsh-status-mcp": "./lib/mcp-server.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SKILL.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "overlay",
    "status",
    "gtk3",
    "uos",
    "arm64",
    "linux",
    "mcp",
    "mcp-server",
    "cross-platform"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangshichao/dsh-status-overlay.git"
  },
  "bugs": {
    "url": "https://github.com/huangshichao/dsh-status-overlay/issues"
  },
  "homepage": "https://github.com/huangshichao/dsh-status-overlay#readme"
}
